@page "/service-accounts"
@attribute [Authorize]
@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PersistentComponentState ApplicationState
@inject DeveloperPlatform.Web.Http.TokenProvider TokenProvider

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Service accounts &mdash; Developer Platform</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">Service accounts</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Machine identities that authenticate with API keys.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreateDialog">
            New service account
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudDataGrid T="ServiceAccountDto" Items="_serviceAccounts" Bordered="false" Hover="true" Elevation="0" Dense="true">
            <Columns>
                <PropertyColumn Property="s => s.Name" Title="Name" />
                <PropertyColumn Property="s => s.Description" Title="Description" />
                <TemplateColumn Title="Created" SortBy="s => s.CreatedAt">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.CreatedAt.ToString("yyyy-MM-dd")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" CellStyle="text-align:right;width:120px;">
                    <CellTemplate>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Key"
                                   OnClick="@(() => OpenKeysDialog(context.Item))">
                            Keys
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.SmartToy" Size="Size.Large" Class="mud-text-disabled" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No service accounts yet. Create one to issue API keys.</MudText>
                </MudStack>
            </NoRecordsContent>
        </MudDataGrid>
    }
</MudStack>

@code {
    private IReadOnlyList<ServiceAccountDto> _serviceAccounts = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (ApplicationState.TryTakeFromJson<string>("AccessToken", out var token))
        {
            TokenProvider.AccessToken = token;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _serviceAccounts = await ApiClient.GetServiceAccountsAsync();
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var permissions = await ApiClient.GetPermissionsAsync();
        var parameters = new DialogParameters<CreateServiceAccountDialog> { { x => x.Permissions, permissions } };
        var dialog = await DialogService.ShowAsync<CreateServiceAccountDialog>("New service account", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled &&
            result.Data is ValueTuple<string, string?, List<string>> value)
        {
            var (name, description, tokens) = value;
            var id = await ApiClient.CreateServiceAccountAsync(name, description, tokens);
            if (id is not null)
            {
                Snackbar.Add("Service account created.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add("Couldn't create the service account. You can only grant permissions you hold.", Severity.Error);
            }
        }
    }

    private async Task OpenKeysDialog(ServiceAccountDto sa)
    {
        var parameters = new DialogParameters<ManageKeysDialog>
        {
            { x => x.ServiceAccountId, sa.PrincipalId },
            { x => x.ServiceAccountName, sa.Name },
        };
        await DialogService.ShowAsync<ManageKeysDialog>($"API keys — {sa.Name}", parameters);
    }
}
