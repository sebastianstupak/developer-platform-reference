@page "/audit"
@attribute [Authorize]
@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PersistentComponentState ApplicationState
@inject DeveloperPlatform.Web.Http.TokenProvider TokenProvider

<PageTitle>Audit log &mdash; Developer Platform</PageTitle>

<MudStack Spacing="6">
    <div>
        <MudText Typo="Typo.h5" GutterBottom="true">Audit log</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">A record of actions taken in this tenant.</MudText>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.End" Class="flex-wrap">
                <MudDatePicker Label="From" @bind-Date="_from" @bind-Date:after="ReloadAsync"
                               Variant="Variant.Outlined" Clearable="true" Style="min-width:180px;" />
                <MudDatePicker Label="To" @bind-Date="_to" @bind-Date:after="ReloadAsync"
                               Variant="Variant.Outlined" Clearable="true" Style="min-width:180px;" />
                <div style="min-width:260px;">
                    <MudAutocomplete T="ActorOption" Label="Actor" Variant="Variant.Outlined"
                                     SearchFunc="SearchActors" ToStringFunc="@(a => a?.Label ?? string.Empty)"
                                     Value="_actorPick" ValueChanged="OnActorSelected"
                                     ResetValueOnEmptyText="true" CoerceText="false" Clearable="true"
                                     Placeholder="Search members or service accounts" />
                    @if (_selectedActors.Count > 0)
                    {
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            @foreach (var a in _selectedActors)
                            {
                                <MudChip T="ActorOption" Size="Size.Small" Value="a"
                                         OnClose="@(() => RemoveActor(a))">@a.Label</MudChip>
                            }
                        </div>
                    }
                </div>
                <MudSelect T="string" Label="Action" MultiSelection="true"
                           @bind-SelectedValues="_actions" @bind-SelectedValues:after="ReloadAsync"
                           Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter" Style="min-width:220px;">
                    @foreach (var c in _commandTypes)
                    {
                        <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="Status" MultiSelection="true"
                           @bind-SelectedValues="_statuses" @bind-SelectedValues:after="ReloadAsync"
                           Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter" Style="min-width:160px;">
                    <MudSelectItem T="string" Value="@("Success")">Success</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Failed")">Failed</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" Label="Cross-tenant only" @bind-Value="_crossTenantOnly" @bind-Value:after="ReloadAsync"
                           Color="Color.Primary" />
            </MudStack>
        </MudPaper>

        <MudDataGrid T="AuditEventDto" @ref="_grid" ServerData="LoadServerData"
                     Bordered="false" Hover="true" Elevation="0" Dense="true"
                     Filterable="false" SortMode="SortMode.None"
                     RowClick="@(args => OpenDetailAsync(args.Item))">
            <Columns>
                <TemplateColumn Title="Time">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (context.Item.IsCrossTenant)
                            {
                                <MudTooltip Text="Cross-tenant action">
                                    <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" Color="Color.Warning" />
                                </MudTooltip>
                            }
                            <MudText Typo="Typo.body2">@context.Item.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actor">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@(context.Item.ActorDisplay ?? "system")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="e => e.CommandType" Title="Action" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.Item.Status == "Success" ? Color.Success : Color.Error)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Scope">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@ScopeDisplay(context.Item)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="e => e.IpAddress" Title="IP" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="AuditEventDto" PageSizeOptions="new[] { 25, 50, 100 }" />
            </PagerContent>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Large" Class="mud-text-disabled" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No audit events.</MudText>
                </MudStack>
            </NoRecordsContent>
        </MudDataGrid>
    }
</MudStack>

@code {
    private bool _loading = true;
    private IReadOnlyList<MemberDto> _members = [];
    private IReadOnlyList<ServiceAccountDto> _serviceAccounts = [];
    private IReadOnlyList<string> _commandTypes = [];

    private MudDataGrid<AuditEventDto>? _grid;

    private DateTime? _from;
    private DateTime? _to;
    private ActorOption? _actorPick;
    private readonly List<ActorOption> _selectedActors = [];
    private List<ActorOption> _allActors = [];
    private IReadOnlyCollection<string> _actions = new HashSet<string>();
    private IReadOnlyCollection<string> _statuses = new HashSet<string>();
    private bool _crossTenantOnly;

    private sealed record ActorOption(Guid Id, string Label);

    protected override async Task OnInitializedAsync()
    {
        if (ApplicationState.TryTakeFromJson<string>("AccessToken", out var token))
        {
            TokenProvider.AccessToken = token;
        }

        _members = await ApiClient.GetMembersAsync();
        _serviceAccounts = await ApiClient.GetServiceAccountsAsync();
        _commandTypes = await ApiClient.GetAuditCommandTypesAsync();

        _allActors = _members.Select(m => new ActorOption(m.PrincipalId, m.Email))
            .Concat(_serviceAccounts.Select(s => new ActorOption(s.PrincipalId, s.Name)))
            .ToList();

        _loading = false;
    }

    private Task<IEnumerable<ActorOption>> SearchActors(string value, CancellationToken ct)
    {
        var selected = _selectedActors.Select(a => a.Id).ToHashSet();
        var matches = _allActors.Where(a => !selected.Contains(a.Id));
        if (!string.IsNullOrWhiteSpace(value))
        {
            matches = matches.Where(a => a.Label.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(matches.Take(50));
    }

    private async Task OnActorSelected(ActorOption? actor)
    {
        if (actor is not null && _selectedActors.All(a => a.Id != actor.Id))
        {
            _selectedActors.Add(actor);
        }

        _actorPick = null; // clear the field so it's ready for the next search
        await ReloadAsync();
    }

    private async Task RemoveActor(ActorOption actor)
    {
        _selectedActors.RemoveAll(a => a.Id == actor.Id);
        await ReloadAsync();
    }

    private async Task<GridData<AuditEventDto>> LoadServerData(GridState<AuditEventDto> state, CancellationToken ct)
    {
        var filter = new AuditFilterDto(
            _from,
            _to?.Date.AddDays(1).AddTicks(-1),
            _selectedActors.Select(a => a.Id).ToList(),
            _actions.ToList(),
            _statuses.ToList(),
            _crossTenantOnly ? true : null);

        var result = await ApiClient.GetAuditEventsAsync(filter, state.Page + 1, state.PageSize, ct);

        return new GridData<AuditEventDto>
        {
            Items = result.Items,
            TotalItems = result.Total,
        };
    }

    private async Task ReloadAsync()
    {
        if (_grid is null)
        {
            return;
        }

        _grid.NavigateTo(Page.First);
        await _grid.ReloadServerData();
    }

    private static string ScopeDisplay(AuditEventDto e)
    {
        var scope = e.EnvironmentId ?? e.ProjectId;
        return scope is null ? "—" : scope.Value.ToString()[..8];
    }

    private async Task OpenDetailAsync(AuditEventDto item)
    {
        var detail = await ApiClient.GetAuditEventDetailAsync(item.Id);
        if (detail is null)
        {
            Snackbar.Add("Couldn't load the audit event detail.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<AuditDetailDialog> { { x => x.Detail, detail } };
        await DialogService.ShowAsync<AuditDetailDialog>($"Audit event — {detail.Event.CommandType}", parameters);
    }
}
