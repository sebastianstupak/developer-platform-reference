@page "/projects"
@attribute [Authorize]
@using DeveloperPlatform.Web.Components.Shared
@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject DeveloperPlatform.Web.Http.TokenProvider TokenProvider

<PageTitle>Projects &mdash; Developer Platform</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">Projects</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage your developer platform projects.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="OpenCreateDialog">
            New Project
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_projects.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Large" Class="mud-text-disabled" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No projects yet. Create your first one.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                       OnClick="OpenCreateDialog">New Project</MudButton>
        </MudStack>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var project in _projects)
            {
                <MudItem xs="12" sm="6" md="4" @key="project.Id">
                    <div class="dp-card project-card" tabindex="0" role="button"
                         @onclick="@(() => Navigation.NavigateTo($"/projects/{project.Id}"))"
                         @onkeydown="@(e => OnCardKey(e, project.Id))">
                        <div class="dp-card__head">
                            <span class="dp-avatar">@(project.Name.Length > 0 ? char.ToUpperInvariant(project.Name[0]).ToString() : "·")</span>
                            <span class="dp-card__title">@project.Name</span>
                            <div @onclick:stopPropagation="true" class="dp-card__action">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                               Color="Color.Default" aria-label="@($"Delete {project.Name}")"
                                               OnClick="@(() => DeleteProjectAsync(project.Id))" />
                            </div>
                        </div>
                        <p class="dp-card__desc">
                            @(string.IsNullOrWhiteSpace(project.Description) ? "No description" : project.Description)
                        </p>
                        <div class="dp-card__meta">
                            <span class="dp-meta"><MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" />
                                <span class="dp-mono">@project.EnvironmentCount</span>&nbsp;@(project.EnvironmentCount == 1 ? "environment" : "environments")</span>
                            <span class="dp-meta__sep"></span>
                            <span class="dp-meta">updated @TimeFormat.Relative(project.LastActivityAt)</span>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private IReadOnlyList<ProjectDto> _projects = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (ApplicationState.TryTakeFromJson<string>("AccessToken", out var token))
        {
            TokenProvider.AccessToken = token;
        }

        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        _loading = true;
        _projects = await ApiClient.GetProjectsAsync();
        _loading = false;
    }

    private void OnCardKey(KeyboardEventArgs e, Guid projectId)
    {
        if (e.Key is "Enter" or " ")
        {
            Navigation.NavigateTo($"/projects/{projectId}");
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateProjectDialog>("New Project");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is ValueTuple<string, string?> value)
        {
            var (name, description) = value;
            var id = await ApiClient.CreateProjectAsync(name, description);
            if (id is not null)
            {
                Snackbar.Add("Project created.", Severity.Success);
                await LoadProjectsAsync();
            }
            else
            {
                Snackbar.Add("Failed to create project. Please try again.", Severity.Error);
            }
        }
    }

    private async Task DeleteProjectAsync(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete project",
            "This will permanently delete the project. Continue?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed is not true)
            return;

        var ok = await ApiClient.DeleteProjectAsync(id);
        if (ok)
        {
            Snackbar.Add("Project deleted.", Severity.Success);
            await LoadProjectsAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete project.", Severity.Error);
        }
    }
}
