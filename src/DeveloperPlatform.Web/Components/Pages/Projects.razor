@page "/projects"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Projects &mdash; Developer Platform</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">Projects</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage your developer platform projects.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="OpenCreateDialog">
            New Project
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudDataGrid T="ProjectDto" Items="_projects"
                     Bordered="false" Striped="false" Hover="true" Elevation="0"
                     Dense="true">
            <Columns>
                <PropertyColumn Property="p => p.Name" Title="Name" />
                <PropertyColumn Property="p => p.Description" Title="Description" />
                <TemplateColumn Title="Created" SortBy="p => p.CreatedAt">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @context.Item.CreatedAt.ToString("yyyy-MM-dd")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" CellStyle="text-align:right;width:56px;">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       aria-label="Delete project"
                                       OnClick="@(() => DeleteProjectAsync(context.Item.Id))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen"
                             Size="Size.Large"
                             Class="mud-text-disabled" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No projects yet. Create your first one.
                    </MudText>
                </MudStack>
            </NoRecordsContent>
        </MudDataGrid>
    }
</MudStack>

@* Inline create dialog *@
<MudDialog @bind-Visible="_createDialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">New Project</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_newName"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Name is required."
                          MaxLength="200"
                          Immediate="true" />
            <MudTextField @bind-Value="_newDescription"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLength="500" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateDialog" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="SubmitCreateAsync"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(string.IsNullOrWhiteSpace(_newName) || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<ProjectDto> _projects = [];
    private bool _loading = true;
    private bool _createDialogOpen;
    private bool _saving;
    private string _newName = string.Empty;
    private string? _newDescription;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        _loading = true;
        _projects = await ApiClient.GetProjectsAsync();
        _loading = false;
    }

    private void OpenCreateDialog()
    {
        _newName = string.Empty;
        _newDescription = null;
        _createDialogOpen = true;
    }

    private void CloseCreateDialog()
    {
        _createDialogOpen = false;
    }

    private async Task SubmitCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
            return;

        _saving = true;
        var id = await ApiClient.CreateProjectAsync(_newName.Trim(), _newDescription?.Trim());
        _saving = false;

        if (id is not null)
        {
            _createDialogOpen = false;
            Snackbar.Add("Project created.", Severity.Success);
            await LoadProjectsAsync();
        }
        else
        {
            Snackbar.Add("Failed to create project. Please try again.", Severity.Error);
        }
    }

    private async Task DeleteProjectAsync(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete project",
            "This will permanently delete the project. Continue?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed is not true)
            return;

        var ok = await ApiClient.DeleteProjectAsync(id);
        if (ok)
        {
            Snackbar.Add("Project deleted.", Severity.Success);
            await LoadProjectsAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete project.", Severity.Error);
        }
    }
}
