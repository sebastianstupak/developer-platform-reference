@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">API keys &mdash; @ServiceAccountName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4" Style="min-width:520px;">
            @if (_issuedKey is not null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" NoIcon="false">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body2">Copy this key now — it won't be shown again.</MudText>
                        <MudTextField Value="_issuedKey" ReadOnly="true" Variant="Variant.Outlined"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.ContentCopy"
                                      OnAdornmentClick="CopyIssuedKey" Typo="Typo.body2" />
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _issuedKey = null)">Done</MudButton>
                    </MudStack>
                </MudAlert>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="_newKeyName" Label="Key name" Variant="Variant.Outlined"
                              Immediate="true" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                           Disabled="@(string.IsNullOrWhiteSpace(_newKeyName) || _issuing)" OnClick="IssueKeyAsync">
                    Issue key
                </MudButton>
            </MudStack>

            <MudDataGrid T="ApiKeyDto" Items="_keys" Bordered="false" Hover="true" Elevation="0" Dense="true">
                <Columns>
                    <PropertyColumn Property="k => k.Name" Title="Name" />
                    <TemplateColumn Title="Prefix">
                        <CellTemplate><code>@context.Item.KeyPrefix&hellip;</code></CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Last used">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @(context.Item.LastUsedAt?.ToString("yyyy-MM-dd") ?? "—")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@(context.Item.IsRevoked ? Color.Error : Color.Success)">
                                @(context.Item.IsRevoked ? "Revoked" : "Active")
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="" CellStyle="text-align:right;width:56px;">
                        <CellTemplate>
                            @if (!context.Item.IsRevoked)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Default"
                                               aria-label="Revoke key" OnClick="@(() => RevokeKeyAsync(context.Item.Id))" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-4">No keys yet. Issue one above.</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid ServiceAccountId { get; set; }
    [Parameter] public string ServiceAccountName { get; set; } = string.Empty;

    private IReadOnlyList<ApiKeyDto> _keys = [];
    private string _newKeyName = string.Empty;
    private string? _issuedKey;
    private bool _issuing;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _keys = await ApiClient.GetApiKeysAsync(ServiceAccountId);

    private async Task IssueKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName))
        {
            return;
        }

        _issuing = true;
        var issued = await ApiClient.IssueApiKeyAsync(ServiceAccountId, _newKeyName.Trim());
        _issuing = false;

        if (issued is not null)
        {
            _issuedKey = issued.PlaintextKey;
            _newKeyName = string.Empty;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Couldn't issue the key.", Severity.Error);
        }
    }

    private async Task RevokeKeyAsync(Guid credentialId)
    {
        if (await ApiClient.RevokeApiKeyAsync(ServiceAccountId, credentialId))
        {
            Snackbar.Add("Key revoked.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Couldn't revoke the key.", Severity.Error);
        }
    }

    private void CopyIssuedKey() => Snackbar.Add("Select the key text and copy it.", Severity.Info);

    private void Close() => MudDialog.Close();
}
