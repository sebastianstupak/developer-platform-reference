@page "/projects/{ProjectId:guid}"
@attribute [Authorize]
@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject DeveloperPlatform.Web.Http.TokenProvider TokenProvider

<PageTitle>@(_project?.Name ?? "Project") &mdash; Developer Platform</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"
                           aria-label="Back to projects" OnClick="@(() => Navigation.NavigateTo("/projects"))" />
            <div>
                <MudText Typo="Typo.h5" GutterBottom="true">@(_project?.Name ?? "Project")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Environments and secrets.</MudText>
            </div>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="OpenCreateEnvironmentDialog">
            New environment
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_environments.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Large" Class="mud-text-disabled" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                No environments yet. Create your first one.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                       OnClick="OpenCreateEnvironmentDialog">
                New environment
            </MudButton>
        </MudStack>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_activePanelIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            @foreach (var env in _environments)
            {
                <MudTabPanel @key="env.Id" ID="@env.Id">
                    <TabContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText>@env.Name</MudText>
                            <div @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Default"
                                               aria-label="@($"Rename {env.Name}")" OnClick="@(() => OpenRenameEnvironmentDialog(env))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Default"
                                               aria-label="@($"Delete {env.Name}")" OnClick="@(() => DeleteEnvironmentAsync(env))" />
                            </div>
                        </MudStack>
                    </TabContent>
                    <ChildContent>
                        <MudStack Spacing="4" Class="pa-4">
                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                                           OnClick="@(() => OpenAddSecretDialog(env))">
                                    Add secret
                                </MudButton>
                            </MudStack>

                            <MudDataGrid T="SecretDto" Items="@GetSecrets(env.Id)" Bordered="false" Hover="true" Elevation="0" Dense="true">
                                <Columns>
                                    <PropertyColumn Property="s => s.Name" Title="Name" />
                                    <TemplateColumn Title="Updated" SortBy="s => s.UpdatedAt">
                                        <CellTemplate>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                @context.Item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
                                            </MudText>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="" CellStyle="text-align:right;width:150px;">
                                        <CellTemplate>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Default"
                                                           aria-label="Reveal secret" OnClick="@(() => RevealSecretAsync(env, context.Item))" />
                                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Default"
                                                           aria-label="Edit secret" OnClick="@(() => OpenEditSecretDialog(env, context.Item))" />
                                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Default"
                                                           aria-label="Delete secret" OnClick="@(() => DeleteSecretAsync(env, context.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <NoRecordsContent>
                                    <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Outlined.Key" Size="Size.Large" Class="mud-text-disabled" />
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            No secrets in this environment yet.
                                        </MudText>
                                    </MudStack>
                                </NoRecordsContent>
                            </MudDataGrid>
                        </MudStack>
                    </ChildContent>
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private IReadOnlyList<EnvironmentDto> _environments = [];
    private readonly Dictionary<Guid, IReadOnlyList<SecretDto>> _secretsByEnv = new();
    private ProjectDto? _project;
    private bool _loading = true;
    private int _activePanelIndex;

    protected override async Task OnInitializedAsync()
    {
        if (ApplicationState.TryTakeFromJson<string>("AccessToken", out var token))
        {
            TokenProvider.AccessToken = token;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        var projects = await ApiClient.GetProjectsAsync();
        _project = projects.FirstOrDefault(p => p.Id == ProjectId);

        _environments = await ApiClient.GetEnvironmentsAsync(ProjectId);

        _secretsByEnv.Clear();
        foreach (var env in _environments)
        {
            _secretsByEnv[env.Id] = await ApiClient.GetSecretsAsync(ProjectId, env.Id);
        }

        _loading = false;
    }

    private IReadOnlyList<SecretDto> GetSecrets(Guid environmentId)
        => _secretsByEnv.TryGetValue(environmentId, out var secrets) ? secrets : [];

    private async Task RefreshSecretsAsync(Guid environmentId)
    {
        _secretsByEnv[environmentId] = await ApiClient.GetSecretsAsync(ProjectId, environmentId);
    }

    private int IndexOfEnvironment(Guid environmentId)
    {
        for (var i = 0; i < _environments.Count; i++)
        {
            if (_environments[i].Id == environmentId)
            {
                return i;
            }
        }

        return -1;
    }

    private async Task OpenCreateEnvironmentDialog()
    {
        var dialog = await DialogService.ShowAsync<EnvironmentDialog>("New environment");
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> value)
        {
            return;
        }

        var (name, type) = value;
        try
        {
            var newEnvironmentId = await ApiClient.CreateEnvironmentAsync(ProjectId, name, type);
            Snackbar.Add("Environment created.", Severity.Success);
            await LoadAsync();

            var index = IndexOfEnvironment(newEnvironmentId);
            if (index >= 0)
            {
                _activePanelIndex = index;
            }
        }
        catch
        {
            Snackbar.Add("Couldn't create the environment.", Severity.Error);
        }
    }

    private async Task OpenRenameEnvironmentDialog(EnvironmentDto env)
    {
        var parameters = new DialogParameters<EnvironmentDialog>
        {
            { x => x.Name, env.Name },
            { x => x.IsCreateMode, false },
        };
        var dialog = await DialogService.ShowAsync<EnvironmentDialog>($"Rename environment — {env.Name}", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name)
        {
            return;
        }

        try
        {
            await ApiClient.RenameEnvironmentAsync(ProjectId, env.Id, name);
            Snackbar.Add("Environment renamed.", Severity.Success);
            await LoadAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't rename the environment.", Severity.Error);
        }
    }

    private async Task DeleteEnvironmentAsync(EnvironmentDto env)
    {
        var parameters = new DialogParameters<DeleteEnvironmentDialog>
        {
            { x => x.EnvironmentName, env.Name },
        };
        var dialog = await DialogService.ShowAsync<DeleteEnvironmentDialog>("Delete environment", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteEnvironmentAsync(ProjectId, env.Id);
            Snackbar.Add("Environment deleted.", Severity.Success);
            await LoadAsync();
            _activePanelIndex = 0;
        }
        catch
        {
            Snackbar.Add("Couldn't delete the environment.", Severity.Error);
        }
    }

    private async Task OpenAddSecretDialog(EnvironmentDto env)
    {
        var dialog = await DialogService.ShowAsync<SecretDialog>("Add secret");
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> value)
        {
            return;
        }

        var (name, secretValue) = value;
        try
        {
            await ApiClient.SetSecretAsync(ProjectId, env.Id, name, secretValue);
            Snackbar.Add("Secret saved.", Severity.Success);
            await RefreshSecretsAsync(env.Id);
        }
        catch
        {
            Snackbar.Add("Couldn't save the secret.", Severity.Error);
        }
    }

    private async Task OpenEditSecretDialog(EnvironmentDto env, SecretDto secret)
    {
        var parameters = new DialogParameters<SecretDialog>
        {
            { x => x.Name, secret.Name },
            { x => x.IsNameEditable, false },
        };
        var dialog = await DialogService.ShowAsync<SecretDialog>($"Edit secret — {secret.Name}", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> value)
        {
            return;
        }

        var (name, secretValue) = value;
        try
        {
            await ApiClient.SetSecretAsync(ProjectId, env.Id, name, secretValue);
            Snackbar.Add("Secret updated.", Severity.Success);
            await RefreshSecretsAsync(env.Id);
        }
        catch
        {
            Snackbar.Add("Couldn't update the secret.", Severity.Error);
        }
    }

    private async Task RevealSecretAsync(EnvironmentDto env, SecretDto secret)
    {
        try
        {
            var value = await ApiClient.RevealSecretAsync(ProjectId, env.Id, secret.Name);
            var parameters = new DialogParameters<RevealSecretDialog>
            {
                { x => x.SecretName, secret.Name },
                { x => x.Value, value },
            };
            await DialogService.ShowAsync<RevealSecretDialog>($"Secret value — {secret.Name}", parameters);
        }
        catch
        {
            Snackbar.Add("Couldn't reveal the secret.", Severity.Error);
        }
    }

    private async Task DeleteSecretAsync(EnvironmentDto env, SecretDto secret)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete secret",
            $"This will permanently delete \"{secret.Name}\". Continue?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed is not true)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteSecretAsync(ProjectId, env.Id, secret.Name);
            Snackbar.Add("Secret deleted.", Severity.Success);
            await RefreshSecretsAsync(env.Id);
        }
        catch
        {
            Snackbar.Add("Couldn't delete the secret.", Severity.Error);
        }
    }
}
