@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Secret value &mdash; @SecretName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:min(480px, 92vw);">
            <MudTextField Value="@Value"
                          ReadOnly="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          InputType="@_inputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_adornmentIcon"
                          OnAdornmentClick="ToggleVisibility"
                          Style="font-family:monospace;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyValueAsync">
                Copy
            </MudButton>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string SecretName { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    private InputType _inputType = InputType.Password;
    private string _adornmentIcon = Icons.Material.Filled.VisibilityOff;

    private void ToggleVisibility()
    {
        if (_inputType == InputType.Password)
        {
            _inputType = InputType.Text;
            _adornmentIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _inputType = InputType.Password;
            _adornmentIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task CopyValueAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
            Snackbar.Add("Secret value copied to clipboard.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Couldn't copy automatically — select the text and copy it.", Severity.Info);
        }
    }

    private void Close() => MudDialog.Close();
}
