@page "/projects/{ProjectId:guid}/environments/{EnvironmentId:guid}"
@attribute [Authorize]
@using DeveloperPlatform.Web.Components.Shared
@using DeveloperPlatform.Web.State
@inject DeveloperPlatformApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ActiveContextService Context
@inject PersistentComponentState ApplicationState
@inject DeveloperPlatform.Web.Http.TokenProvider TokenProvider

<PageTitle>@(_environment?.Name ?? "Environment") &mdash; @(_project?.Name ?? "Project")</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"
                           aria-label="Back to project overview"
                           OnClick="@(() => Navigation.NavigateTo($"/projects/{ProjectId}"))" />
            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5">@(_environment?.Name ?? "Environment")</MudText>
                    @if (_environment is not null)
                    {
                        <EnvTypeChip Type="@_environment.Type" />
                    }
                </MudStack>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(_project?.Name ?? "Project") · secrets</MudText>
            </div>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                       Disabled="@(_environment is null)" OnClick="OpenAddSecretDialog">Add secret</MudButton>
            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     Disabled="@(_environment is null)">
                <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="OpenRenameEnvironmentDialog">Rename environment</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline" OnClick="DeleteEnvironmentAsync">Delete environment</MudMenuItem>
            </MudMenu>
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_environment is null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Class="mud-text-disabled" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Environment not found.</MudText>
        </MudStack>
    }
    else
    {
        <MudDataGrid T="SecretDto" Items="_secrets" Bordered="false" Hover="true" Elevation="0" Dense="true">
            <Columns>
                <PropertyColumn Property="s => s.Name" Title="Name" />
                <TemplateColumn Title="Updated" SortBy="s => s.UpdatedAt">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@TimeFormat.Relative(context.Item.UpdatedAt)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" CellStyle="text-align:right;width:150px;">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Default"
                                       aria-label="Reveal secret" OnClick="@(() => RevealSecretAsync(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Default"
                                       aria-label="Edit secret" OnClick="@(() => OpenEditSecretDialog(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Default"
                                       aria-label="Delete secret" OnClick="@(() => DeleteSecretAsync(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.Key" Size="Size.Large" Class="mud-text-disabled" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No secrets in this environment yet.</MudText>
                </MudStack>
            </NoRecordsContent>
        </MudDataGrid>
    }
</MudStack>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid EnvironmentId { get; set; }

    private ProjectDto? _project;
    private EnvironmentDto? _environment;
    private IReadOnlyList<SecretDto> _secrets = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (ApplicationState.TryTakeFromJson<string>("AccessToken", out var token))
        {
            TokenProvider.AccessToken = token;
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var projects = await ApiClient.GetProjectsAsync();
        _project = projects.FirstOrDefault(p => p.Id == ProjectId);
        if (_project is not null)
        {
            Context.SetProject(new ActiveProjectRef(_project.Id, _project.Name));
        }

        var environments = await ApiClient.GetEnvironmentsAsync(ProjectId);
        _environment = environments.FirstOrDefault(e => e.Id == EnvironmentId);
        if (_environment is not null)
        {
            Context.SetEnvironment(new ActiveEnvironmentRef(_environment.Id, _environment.Name, _environment.Type));
            _secrets = await ApiClient.GetSecretsAsync(ProjectId, EnvironmentId);
        }
        else
        {
            _secrets = [];
        }

        _loading = false;
    }

    private async Task RefreshSecretsAsync() => _secrets = await ApiClient.GetSecretsAsync(ProjectId, EnvironmentId);

    private async Task OpenAddSecretDialog()
    {
        var dialog = await DialogService.ShowAsync<SecretDialog>("Add secret");
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> value)
        {
            return;
        }

        var (name, secretValue) = value;
        try
        {
            await ApiClient.SetSecretAsync(ProjectId, EnvironmentId, name, secretValue);
            Snackbar.Add("Secret saved.", Severity.Success);
            await RefreshSecretsAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't save the secret.", Severity.Error);
        }
    }

    private async Task OpenEditSecretDialog(SecretDto secret)
    {
        var parameters = new DialogParameters<SecretDialog>
        {
            { x => x.Name, secret.Name },
            { x => x.IsNameEditable, false },
        };
        var dialog = await DialogService.ShowAsync<SecretDialog>($"Edit secret — {secret.Name}", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> value)
        {
            return;
        }

        var (name, secretValue) = value;
        try
        {
            await ApiClient.SetSecretAsync(ProjectId, EnvironmentId, name, secretValue);
            Snackbar.Add("Secret updated.", Severity.Success);
            await RefreshSecretsAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't update the secret.", Severity.Error);
        }
    }

    private async Task RevealSecretAsync(SecretDto secret)
    {
        try
        {
            var value = await ApiClient.RevealSecretAsync(ProjectId, EnvironmentId, secret.Name);
            var parameters = new DialogParameters<RevealSecretDialog>
            {
                { x => x.SecretName, secret.Name },
                { x => x.Value, value },
            };
            await DialogService.ShowAsync<RevealSecretDialog>($"Secret value — {secret.Name}", parameters);
        }
        catch
        {
            Snackbar.Add("Couldn't reveal the secret.", Severity.Error);
        }
    }

    private async Task DeleteSecretAsync(SecretDto secret)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete secret", $"This will permanently delete \"{secret.Name}\". Continue?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed is not true)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteSecretAsync(ProjectId, EnvironmentId, secret.Name);
            Snackbar.Add("Secret deleted.", Severity.Success);
            await RefreshSecretsAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't delete the secret.", Severity.Error);
        }
    }

    private async Task OpenRenameEnvironmentDialog()
    {
        if (_environment is null)
        {
            return;
        }

        var parameters = new DialogParameters<EnvironmentDialog>
        {
            { x => x.Name, _environment.Name },
            { x => x.IsCreateMode, false },
        };
        var dialog = await DialogService.ShowAsync<EnvironmentDialog>($"Rename environment — {_environment.Name}", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string name)
        {
            return;
        }

        try
        {
            await ApiClient.RenameEnvironmentAsync(ProjectId, EnvironmentId, name);
            Snackbar.Add("Environment renamed.", Severity.Success);
            await LoadAsync();
        }
        catch
        {
            Snackbar.Add("Couldn't rename the environment.", Severity.Error);
        }
    }

    private async Task DeleteEnvironmentAsync()
    {
        if (_environment is null)
        {
            return;
        }

        var parameters = new DialogParameters<DeleteEnvironmentDialog>
        {
            { x => x.EnvironmentName, _environment.Name },
        };
        var dialog = await DialogService.ShowAsync<DeleteEnvironmentDialog>("Delete environment", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        try
        {
            await ApiClient.DeleteEnvironmentAsync(ProjectId, EnvironmentId);
            Context.SetEnvironment(null);
            Snackbar.Add("Environment deleted.", Severity.Success);
            Navigation.NavigateTo($"/projects/{ProjectId}");
        }
        catch
        {
            Snackbar.Add("Couldn't delete the environment.", Severity.Error);
        }
    }
}
